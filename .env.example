# ---------------------------------------------------------------------------
# nour-code configuration (copy to .env and edit)
# Every variable is prefixed with NOUR_CODE_ ; see nour_code/config.py.
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------
NOUR_CODE_HOST=0.0.0.0
NOUR_CODE_PORT=8000
NOUR_CODE_LOG_LEVEL=INFO
NOUR_CODE_ENVIRONMENT=development
NOUR_CODE_CORS_ORIGINS=*

# --- Ollama / model ---------------------------------------------------------
NOUR_CODE_OLLAMA_BASE_URL=http://localhost:11434
NOUR_CODE_MODEL=qwen3:8b
NOUR_CODE_TEMPERATURE=0.1
NOUR_CODE_NUM_CTX=16384
NOUR_CODE_REQUEST_TIMEOUT_SECONDS=600
NOUR_CODE_CONNECT_TIMEOUT_SECONDS=10

# --- agent loop -------------------------------------------------------------
NOUR_CODE_MAX_ITERATIONS=15
# Wall-clock budget for one turn, and an optional token budget per turn (0 = unlimited).
NOUR_CODE_MAX_TURN_SECONDS=900
NOUR_CODE_MAX_TURN_TOKENS=0
# Identical tool calls in a row that count as a stuck loop.
NOUR_CODE_LOOP_DETECTION_THRESHOLD=3
# Parallel agent turns allowed (keep this small: qwen3:8b is single-GPU bound).
NOUR_CODE_MAX_CONCURRENT_TURNS=4
NOUR_CODE_MAX_TOOL_OUTPUT_CHARS=100000
NOUR_CODE_MAX_TOOL_HISTORY_CHARS=20000
NOUR_CODE_MAX_HISTORY_MESSAGES=200
NOUR_CODE_PARALLEL_TOOL_CALLS=false
# Qwen3 thinking mode (unset = leave it to the model).
# NOUR_CODE_ENABLE_THINKING=true

# --- approvals & verification (1.2.0) ---------------------------------------
# off | mutating | all — "mutating" parks write_file/apply_patch/delete_file/run_shell.
NOUR_CODE_APPROVAL_MODE=off
NOUR_CODE_APPROVAL_TIMEOUT_SECONDS=300
NOUR_CODE_VERIFY_DEFAULT=false
NOUR_CODE_VERIFY_TIMEOUT_SECONDS=180
# off | auto | on — plan mode is reserved for 1.3.0.
NOUR_CODE_PLAN_MODE=auto

# --- production-ready mode ---------------------------------------------------
NOUR_CODE_PRODUCTION_AUTO_HARDEN=true
NOUR_CODE_PRODUCTION_MAX_REMEDIATION_ROUNDS=2

# --- paths ------------------------------------------------------------------
# Where the agent may read/write (overrides permissions.yaml allowed_roots).
# Use ":" (Linux/macOS) or ";" (Windows) to separate several roots.
# NOUR_CODE_ALLOWED_ROOTS=/home/me/projects:/home/me/sandbox
NOUR_CODE_WORKING_DIR=.
NOUR_CODE_PERMISSIONS_FILE=./permissions.yaml
# Extra skill directories (":" separated)
# NOUR_CODE_SKILLS_DIRS=./skills:/opt/nour-skills

# --- sessions ---------------------------------------------------------------
NOUR_CODE_SESSION_TTL_SECONDS=7200
NOUR_CODE_SESSIONS_FILE=./nour-code-sessions.json

# --- observability ----------------------------------------------------------
NOUR_CODE_LOG_DIR=./logs
NOUR_CODE_METRICS_ENABLED=true
NOUR_CODE_AUDIT_ENABLED=true

# --- Docker only: talk to Ollama on the host --------------------------------
# NOUR_CODE_OLLAMA_BASE_URL=http://host.docker.internal:11434
